<odoo>
    <template id="report_invoicelabel">
        <t t-call="web.basic_layout">
            <t t-set="sale_order_id" t-value="env['sale.order'].search([('invoice_ids', '=', o.id)])"/>
            <t t-foreach="sale_order_id.order_line" t-as="line">
                <center class="page">
                    <div>
                        <t t-set="company" t-value="o.company_id if o.company_id else res_company"/>
                        <div class="mb-4"><img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo" style="max-height: 95px;"/></div>
                    </div>
                    <div class="mt-4">
                        <t t-if="sale_order_id">
                            <h1 style="font-size:30px"><span t-field="company.name"/></h1>
                            <h1 style="font-size:30px">Customer: <t t-esc="o.partner_id.name"/></h1>
                            <h1 style="font-size:30px">Ship:<span t-field="sale_order_id.x_studio_vessel"/></h1>
                            <h1 style="font-size:30px">PO: # <span t-field="line.order_id.client_order_ref"/></h1>
                            <h1 style="font-size:30px">
                                Item# <span t-esc="line.product_id.default_code or line.product_id.x_studio_y_not_reference"/>
                            </h1>
                            <h1 style="font-size:30px">Item Descrip: <span t-field="line.product_id.product_tmpl_id.name"/></h1>
                            <h1 style="font-size:30px">Total Order Qty: <span t-field="sale_order_id.total_order_qty"/></h1>
                        </t>
                    </div>
                </center>
            </t>
        </t>
    </template>

    <template id="report_invoice_label_details">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="y_not_sale_type.report_invoicelabel"/>
            </t>
        </t>
    </template>
</odoo>
