<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_type_form_view" model="ir.ui.view">
        <field name="name">view.sale.type.form</field>
        <field name="model">sale.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="auto_email_invoice_post"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_type_tree_view" model="ir.ui.view">
        <field name="name">view.sale.type.tree</field>
        <field name="model">sale.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="auto_email_invoice_post" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="sale_type_action" model="ir.actions.act_window">
        <field name="name">Sales Type</field>
        <field name="res_model">sale.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_sale_type"
        name="Sale Type"
        action="sale_type_action"
        parent="sale.menu_sale_config"/>
</odoo>
