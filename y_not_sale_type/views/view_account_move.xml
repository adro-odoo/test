<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_out_invoice_tree_inherit_y_not" model="ir.ui.view">
        <field name="name">account.out.invoice.tree.inherit.y.not</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="sale_type_id"/>
            </field>
        </field>
    </record>

    <record id="view_move_form_inherit_y_not" model="ir.ui.view">
        <field name="name">account.move.form.inherit.y.not</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="payment_reference" position="before">
                <field name="sale_type_id"/>
            </field>
        </field>
    </record>
</odoo>
