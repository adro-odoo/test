<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_worksheet_template_adka">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Worksheet for Task <t t-esc="o.id"/></h2>
                        <t t-if="o.worksheet_template_id">
                            <t t-set="model_name" t-value="'x_project_task_worksheet_template_' + str(o.worksheet_template_id.id)"/>
                            <t t-set="worksheet_record" t-value="env[model_name].search([('x_project_task_id', '=', o.id)], limit=1)"/>
        
                            <t t-if="worksheet_record">
                                <table class="table table-bordered">
                                    <t t-foreach="worksheet_record._fields" t-as="field_name">
                                        <tr>
                                            <td><t t-esc="field_name"/></td>
                                            <td><t t-esc="worksheet_record[field_name]"/></td>
                                        </tr>
                                    </t>
                                </table>
                            </t>
                            <t t-else="">
                                <p>No worksheet data found for this task.</p>
                            </t>
                        </t>
                        <t t-else="">
                            <p>No worksheet template selected.</p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
